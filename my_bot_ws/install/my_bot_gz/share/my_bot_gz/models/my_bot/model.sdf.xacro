<?xml version="1.0"?>
<sdf version="1.9" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="robot_name" default="my_bot"/>

  <model name="$(arg robot_name)">
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link"/>
    <link name="base_footprint"/>

    <joint name="base_footprint_joint" type="fixed">
      <parent>base_link</parent>
      <child>base_footprint</child>
    </joint>

    <link name="chassis">
      <inertial>
        <pose>0.1075 0 0.045 0 0 0</pose>
        <mass>0.4</mass>
        <inertia>
          <ixx>0.000727</ixx>
          <iyy>0.001861</iyy>
          <izz>0.002071</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <pose>0.1075 0 0.045 0 0 0</pose>
        <geometry>
          <box>
            <size>0.215 0.13 0.09</size>
          </box>
        </geometry>
      </collision>
      <visual name="chassis_visual">
        <pose>0.1075 0 0.045 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://my_bot/meshes/box_unit.stl</uri>
            <scale>0.215 0.13 0.09</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="chassis_joint" type="fixed">
      <parent>base_link</parent>
      <child>chassis</child>
      <pose>-0.08 0 0 0 0 0</pose>
    </joint>

    <link name="wheel_left">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000020</ixx>
          <iyy>0.000020</iyy>
          <izz>0.000010</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="wheel_left_collision">
        <geometry>
          <cylinder>
            <radius>0.0325</radius>
            <length>0.025</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
              <slip1>0.02</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="wheel_left_visual">
        <geometry>
          <mesh>
            <uri>package://my_bot/meshes/cylinder_unit.stl</uri>
            <scale>0.065 0.065 0.025</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>1 1 0 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="wheel_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_left</child>
      <pose>0 0.066 0 -1.5708 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <link name="wheel_right">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000020</ixx>
          <iyy>0.000020</iyy>
          <izz>0.000010</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="wheel_right_collision">
        <geometry>
          <cylinder>
            <radius>0.0325</radius>
            <length>0.025</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
              <slip1>0.02</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="wheel_right_visual">
        <geometry>
          <mesh>
            <uri>package://my_bot/meshes/cylinder_unit.stl</uri>
            <scale>0.065 0.065 0.025</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>1 1 0 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="wheel_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_right</child>
      <pose>0 -0.066 0 1.5708 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <link name="caster_wheel">
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="caster_collision">
        <geometry>
          <sphere>
            <radius>0.02</radius>
          </sphere>
        </geometry>
      </collision>
      <visual name="caster_visual">
        <geometry>
          <sphere>
            <radius>0.02</radius>
          </sphere>
        </geometry>
        <material>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="caster_wheel_joint" type="fixed">
      <parent>chassis</parent>
      <child>caster_wheel</child>
      <pose>0.17 0 0 0 0 0</pose>
    </joint>

    <link name="laser_frame">
      <inertial>
        <mass>0.08</mass>
        <inertia>
          <ixx>0.00002</ixx>
          <iyy>0.00002</iyy>
          <izz>0.00002</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="laser_collision">
        <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="laser_visual">
        <geometry>
          <mesh>
            <uri>package://my_bot/meshes/cylinder_unit.stl</uri>
            <scale>0.05 0.05 0.03</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>0 0 1 1</diffuse>
        </material>
      </visual>
      <sensor name="laser_sensor" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>15</update_rate>
        <topic>/scan</topic>
        <gz_frame_id>laser_frame</gz_frame_id>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
      </sensor>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent>chassis</parent>
      <child>laser_frame</child>
      <pose>-0.045 0 0.10 0 0 -1.5708</pose>
    </joint>

    <link name="imu_frame">
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <iyy>0.000001</iyy>
          <izz>0.000001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="imu_visual">
        <geometry>
          <mesh>
            <uri>package://my_bot/meshes/box_unit.stl</uri>
            <scale>0.02 0.015 0.005</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>0 0 1 1</diffuse>
        </material>
      </visual>
      <collision name="imu_collision">
        <geometry>
          <box>
            <size>0.02 0.015 0.005</size>
          </box>
        </geometry>
      </collision>
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/imu/data_raw</topic>
        <gz_frame_id>imu_frame</gz_frame_id>
      </sensor>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent>chassis</parent>
      <child>imu_frame</child>
      <pose>0.085 -0.045 0 0 0 0</pose>
    </joint>

    <link name="sonar_frame">
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <iyy>0.000001</iyy>
          <izz>0.000001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="sonar_visual">
        <geometry>
          <mesh>
            <uri>package://my_bot/meshes/cylinder_unit.stl</uri>
            <scale>0.02 0.02 0.02</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>
      <collision name="sonar_collision">
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="sonar_joint" type="fixed">
      <parent>chassis</parent>
      <child>sonar_frame</child>
      <pose>-0.075 0 0.02 0 0 0</pose>
    </joint>

    <link name="camera_frame">
      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>0.000004</ixx>
          <iyy>0.000004</iyy>
          <izz>0.000004</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="camera_visual">
        <geometry>
          <mesh>
            <uri>package://my_bot/meshes/box_unit.stl</uri>
            <scale>0.03 0.02 0.015</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>
      <collision name="camera_collision">
        <geometry>
          <box>
            <size>0.03 0.02 0.015</size>
          </box>
        </geometry>
      </collision>
      <sensor name="camera_sensor" type="camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/camera/image_raw</topic>
        <gz_frame_id>camera_frame</gz_frame_id>
        <camera name="rgb_camera">
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20.0</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>chassis</parent>
      <child>camera_frame</child>
      <pose>-0.085 0 0.025 0 0 0</pose>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.132</wheel_separation>
      <wheel_radius>0.0325</wheel_radius>
      <topic>/cmd_vel</topic>
      <max_linear_velocity>1.0</max_linear_velocity>
      <min_linear_velocity>-1.0</min_linear_velocity>
      <max_angular_velocity>2.5</max_angular_velocity>
      <min_angular_velocity>-2.5</min_angular_velocity>
      <odom_publish_frequency>30</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
      <topic>/joint_states</topic>
      <update_rate>30</update_rate>
    </plugin>
  </model>
</sdf>
