<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <link name="sonar_frame">
        <visual>
            <geometry>
                <mesh filename="package://my_bot/meshes/cylinder_unit.stl" scale="0.02 0.02 0.02"/>
            </geometry>
            <material name="gray"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.01" length="0.02"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.01" length="0.02" radius="0.01">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
    
    <joint name="sonar_joint" type ="fixed">
        <parent link="chassis"/>
        <child link="sonar_frame"/>
        <origin xyz= "-0.075 0 0.02" rpy="0 0 0"/>
    </joint>

</robot>
