<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <link name="laser_frame">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://my_bot/meshes/cylinder_unit.stl" scale="0.05 0.05 0.03"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.025" length="0.03"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.08" length="0.03" radius="0.025">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
    
    <joint name="lidar_joint" type ="fixed">
        <parent link="chassis"/>
        <child link="laser_frame"/>
        <origin xyz= "-0.045 0 0.10" rpy="0 0 -1.57"/>
    </joint>

</robot>
